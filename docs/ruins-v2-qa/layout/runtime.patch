 *{box-sizing:border-box}body{margin:0;background:#102725;color:#e7e5cf;font:15px system-ui,sans-serif}main{max-width:1100px;margin:auto;padding:20px}header{display:flex;align-items:center;justify-content:space-between;gap:12px}h1{font-size:28px;margin:6px 0 16px}h1 span,small{color:#a3b9a5}nav{display:flex;gap:18px}a{color:#cfddac}canvas{display:block;width:100%;height:auto;border:1px solid #8d9870;border-radius:12px;background:#263e37}.top{display:flex;justify-content:space-between;gap:14px;padding:10px 0;min-height:50px}#stats{white-space:nowrap;color:#edb78d}button,select{font:inherit;background:#29483f;border:1px solid #9bab80;border-radius:8px;color:#f4edcb;min-height:42px;padding:8px 15px;cursor:pointer}button:hover{background:#426453}button:focus-visible,a:focus-visible{outline:3px solid #f0c678}button[hidden],[hidden]{display:none!important}.toolbar{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}#notice{min-height:24px;color:#c9d3bc;margin:12px 0}.touch{display:flex;justify-content:space-between;gap:16px;touch-action:none;user-select:none}.dpad,.actions{display:flex;gap:8px;flex-wrap:wrap}.touch button{min-width:48px;min-height:48px}footer{font-size:12px;line-height:1.8;color:#a9b6a3;margin-top:18px}#helpbox{border:1px solid #647c65;padding:12px;border-radius:10px;margin-bottom:12px;line-height:1.6}@media(max-width:600px){main{padding:10px}header{align-items:start}h1{font-size:23px}nav{font-size:12px;gap:10px}.top{display:block;font-size:13px}.top div{margin-top:7px}.touch{flex-direction:column}.dpad,.actions{justify-content:center}.toolbar button,.toolbar select{padding:8px 10px;font-size:13px}#notice{font-size:13px}.touch button{flex:1;max-width:110px}footer{font-size:11px}}
+/* Keep live combat, its HUD and all primary actions in one viewport.
+   Secondary setup/help remains below this bounded play shell. */
+main{padding:12px}
+.play-shell{height:calc(100vh - 24px);height:calc(100svh - 24px);display:grid;grid-template-areas:"head" "hud" "field" "notice" "controls";grid-template-rows:auto auto minmax(0,1fr) auto auto;gap:8px}
+header{grid-area:head;min-height:44px}header small{font-size:11px;line-height:1.2}h1{font-size:22px;line-height:1.2;margin:2px 0 0}nav{font-size:12px;gap:14px}
+.quick-actions{display:flex;gap:6px}.quick-actions button{min-height:44px;min-width:70px;padding:7px 12px;font-size:14px}
+.top{grid-area:hud;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;min-height:40px;padding:4px 0;font-size:14px}
+#stats{font-size:14px}
+.field-slot{grid-area:field;container-type:size;min-width:0;min-height:0;display:grid;place-items:center}
+canvas{box-sizing:content-box;width:min(calc(100cqw - 2px),calc((100cqh - 2px)*5/3));height:auto;aspect-ratio:5/3;max-width:none;border-radius:10px;outline-offset:-4px}
+canvas:focus-visible{outline:3px solid #f0c678}
+#notice{grid-area:notice;font-size:13px;line-height:1.5;min-height:22px;margin:0}
+.touch{grid-area:controls;align-items:center;min-height:48px}.dpad,.actions{flex-wrap:nowrap}.touch button{font-size:14px;min-height:48px}.dpad button{width:48px;padding:8px}.actions button{min-width:96px}
+.notes{padding-top:16px}.notes footer{margin-top:12px}
+@media(min-width:900px) and (max-height:650px){
+ .play-shell{grid-template-columns:minmax(0,1fr) 220px;grid-template-areas:"head head" "hud hud" "field controls" "notice notice";grid-template-rows:44px 44px minmax(0,1fr) 24px}
+ .touch{flex-direction:column;justify-content:center;gap:12px}
+ .dpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(2,48px);gap:8px}
+ [data-hold=up]{grid-area:1/2}[data-hold=left]{grid-area:2/1}[data-hold=down]{grid-area:2/2}[data-hold=right]{grid-area:2/3}
+ .actions{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:8px}.actions button{min-width:0;padding:8px}
+}
+@media(max-width:700px){
+ main{padding:10px}.play-shell{height:calc(100vh - 20px);height:calc(100svh - 20px)}
+ header{display:grid;grid-template-columns:1fr auto;grid-template-areas:"title nav" "quick quick";gap:6px}header>div:first-child{grid-area:title}.quick-actions{grid-area:quick;justify-content:center}nav{grid-area:nav;font-size:11px;gap:10px}h1{font-size:20px}
+ .top{display:block;font-size:13px;min-height:44px}.top #stats{font-size:13px;margin-top:4px}
+ .touch{flex-direction:column;gap:8px}.dpad,.actions{display:flex;width:100%;justify-content:space-between;gap:6px}.touch button{flex:1;min-width:0;max-width:none;padding:8px 6px;font-size:13px}
+ #notice{font-size:12px}
