+/* Keep the full square field and live controls in the actual viewport budget.
+   The manual remains in normal document flow below the play area. */
+.play-area{height:calc(100vh - 40px);height:calc(100svh - 40px);display:grid;grid-template-areas:"header" "title" "operation" "command" "bottom" "touch";grid-template-rows:auto auto auto minmax(0,1fr) auto auto}
+header{grid-area:header;position:sticky;top:0;z-index:5;background:#101e24}
+header #pause{min-height:44px;min-width:64px}
+.title{grid-area:title}.operation{grid-area:operation}.command{grid-area:command;min-height:0;align-items:stretch}
+.field-slot{container-type:size;min-width:0;min-height:0;display:grid;place-items:center}
+.arena{width:min(100cqw,100cqh);min-width:0;aspect-ratio:1;margin:0}
+.bottom{grid-area:bottom}.touch{grid-area:touch}
+#overlay{overflow:auto}
+@container(max-height:420px){
+ #overlay{inset:3%;padding:8px;justify-content:flex-start}
+ #overlay .eyebrow{font-size:8px;margin:0}
+ #overlay h2{font-size:18px;margin:5px 0}
+ #result-copy{font-size:11px;line-height:1.35;margin:5px 0}
+ #primary{min-width:0;min-height:34px;padding:7px 10px;margin:6px 0}
+ #retry{font-size:10px;padding:5px;margin:0}
+}
+@media(max-height:760px){
+ main{padding-top:10px;padding-bottom:10px}
+ .play-area{height:calc(100vh - 20px);height:calc(100svh - 20px)}
+ aside{grid-template-columns:1fr 1fr;gap:7px;align-content:start}
+ .status-top,.base-card,.wave{grid-column:1/-1}
+ .base-card,.pilot,.wave{padding:7px 10px}
+ .base-card strong{display:inline;float:right;font-size:19px;margin:0;letter-spacing:5px}
+ .pilot b{display:block;font-size:9px;letter-spacing:0}
+ .pilot strong{display:block;float:none;margin-top:4px;font-size:11px;letter-spacing:2px}
+ .pilot em{font-size:10px;margin-top:4px;min-height:12px}
+ .base-card small,.pilot small,#tip,aside>.small{display:none}
+ .wave small{font-size:10px;margin-top:4px}
+ .wave strong{font-size:17px}
+ body[data-state]:not([data-state=ready]) .title,body[data-state]:not([data-state=ready]) .operation{display:none}
+}
+@media(max-width:760px){
+ main{padding:10px}
+ .play-area{height:calc(100vh - 20px);height:calc(100svh - 20px)}
+ header{font-size:9px;letter-spacing:1px;padding-bottom:8px}
+ .title{margin:10px 0 8px}.title .eyebrow{font-size:9px;margin-bottom:5px}h1{font-size:24px}
+ .operation{padding:8px 0;gap:6px}.operation select{font-size:11px;padding:7px 4px}.operation button{font-size:11px;padding:7px}
+ .command{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);gap:8px}
+ .field-slot{grid-row:2}
+ aside{grid-row:1;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;align-content:start}
+ .status-top{grid-column:1/-1}.status-top .eyebrow{font-size:8px}.status-top strong{font-size:14px}
+ .base-card,.pilot,.wave{grid-column:auto;padding:6px;min-width:0}
+ .base-card span,.wave span{font-size:9px}
+ .base-card strong{display:block;float:none;font-size:17px;letter-spacing:2px;margin:4px 0 0}
+ .pilot b{font-size:9px;letter-spacing:0;display:block}
+ .pilot strong{display:block;float:none;font-size:10px;letter-spacing:1px;margin-top:4px}
+ .pilot em{font-size:9px;margin-top:4px;min-height:12px;overflow-wrap:anywhere}
+ .wave strong{display:block;float:none;font-size:16px;margin-top:4px}
+ .wave small{font-size:8px;margin-top:4px}
+ .base-card small,.pilot small,#tip,aside>.small{display:none}
+ .bottom{gap:8px;font-size:10px;line-height:1.4;display:flex}.bottom p{margin:6px 0}.bottom #save-note{display:none}
+ .touch{margin:4px 0 0;gap:6px}.touch button{min-height:44px;padding:8px}
+ body[data-state]:not([data-state=ready]) .title,body[data-state]:not([data-state=ready]) .operation{display:none}
+}
+@media(pointer:coarse){.touch{display:flex;gap:6px;margin:4px 0 0}.touch button{flex:1;min-height:44px;padding:8px;touch-action:none;user-select:none}}
+@media(min-width:761px) and (max-height:480px){
+ .title{display:none}header{font-size:9px;padding-bottom:6px}header button{padding:8px 12px}
+ .operation{padding:6px 0;font-size:11px}.operation select,.operation button{padding:6px 10px}
+ .bottom{font-size:10px;line-height:1.4}.bottom p{margin:6px 0}.bottom #save-note{display:none}
+}
