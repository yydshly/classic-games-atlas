+.overlay{position:absolute;inset:0;padding:10px;overflow:auto}.card{max-height:100%;overflow:auto}
+.controls{grid-area:controls;width:min(100%,390px);margin:0 auto;gap:12px}
+.dpad{grid-template-columns:repeat(3,44px);grid-template-rows:repeat(2,44px);gap:4px}
+.up{grid-area:1/2}.left{grid-area:2/1}.down{grid-area:2/2}.right{grid-area:2/3}
+.bomb-button{flex-shrink:0;min-width:64px;min-height:64px;width:72px;height:72px}
+.keyboard{grid-area:keyboard;margin:0}#status{grid-area:status;margin:0;font-size:11px}
+.layout>aside{min-height:0;max-height:100%;overflow:auto;align-self:stretch}
+footer{display:block;margin-top:20px;padding-top:12px;overflow-wrap:anywhere}footer a{display:block;margin-top:6px;white-space:normal}
+body[data-state]:not([data-state=ready]) .heading{display:none}
+@container(max-height:400px){
+ .overlay{padding:8px}.card{padding:10px}.card .eyebrow{font-size:8px;line-height:1.2;margin:0}
+ .card h2{font-size:19px;line-height:1.3;margin:5px 0}.card p{font-size:11px;line-height:1.4;margin:0 0 6px}
+ .detail{font-size:9px;line-height:1.4;padding:4px 0;margin:5px 0 7px}.primary{min-height:40px;padding:7px;font-size:12px}.secondary{padding:5px 8px;font-size:11px}
+}
+@media(max-width:760px),(max-height:500px){
+ header{padding:8px 10px;font-size:10px}header>span{font-size:8px;letter-spacing:.7px}
+ main{padding:10px}.layout{grid-template-columns:1fr;grid-template-rows:100% auto;gap:20px}
+ .layout>aside{max-height:none;overflow:visible;margin-bottom:16px}
+ .heading{margin-bottom:10px}.heading h1{font-size:26px}.heading .eyebrow{font-size:8px;margin-bottom:5px}
+ .play{max-width:none;gap:6px}.topline>span{font-size:11px;letter-spacing:.5px}.topline button{font-size:10px;padding:6px 8px}
+ .matchbar{padding:6px 10px}.matchbar>span{font-size:11px}.matchbar b{font-size:9px;margin-left:3px}
+ #clock{font-size:22px;letter-spacing:1px}.controls{max-width:360px}.controls p{font-size:9px}.keyboard{display:none}
+}
+@media(max-height:700px){.heading{display:none}}
+@media(min-width:700px) and (max-height:500px){
+ .play{grid-template-columns:minmax(0,1fr) 220px;grid-template-areas:"field top" "field hud" "field controls" "status status";grid-template-rows:64px 56px minmax(0,1fr) 22px;gap:5px}
+ .topline{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto 44px;gap:3px;align-content:start;justify-content:stretch}.topline>div{justify-content:space-between}.topline button{flex:1;white-space:nowrap}
+ .matchbar{padding:5px 7px}.matchbar>span{font-size:10px}.matchbar b{font-size:8px}.matchbar small{font-size:9px}#clock{font-size:18px;letter-spacing:0}
+ .controls{display:grid;grid-template-columns:1fr;justify-items:center;align-content:center;gap:8px}.controls p{display:none}.bomb-button{width:64px;height:64px}
+ body[data-state]:not([data-state=ready]) header{display:none}
+}
+@media(max-width:360px) and (max-height:700px){
+ .controls{display:grid;grid-template-columns:minmax(0,1fr) 64px;gap:8px}.controls p{display:none}
+ .dpad{grid-template-columns:repeat(4,minmax(44px,1fr));grid-template-rows:44px;gap:4px}
+ .left{grid-area:1/1}.up{grid-area:1/2}.down{grid-area:1/3}.right{grid-area:1/4}
+ .bomb-button{width:64px;height:64px}#status{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+ body[data-state]:not([data-state=ready]) header{display:none}
+}
